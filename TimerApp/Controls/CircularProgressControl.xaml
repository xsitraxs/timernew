<UserControl
    x:Class="TimerApp.Controls.CircularProgressControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="260"
    d:DesignHeight="260">

    <Grid x:Name="RootGrid" SizeChanged="OnSizeChanged">
        <!-- Дорожка кольца -->
        <Ellipse
            x:Name="TrackEllipse"
            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            StrokeThickness="10"
            Opacity="0.22" />
        <!-- Дуга оставшегося времени: геометрия строится в коде по Progress -->
        <Path
            x:Name="ProgressPath"
            StrokeThickness="10"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round" />
    </Grid>
</UserControl>
