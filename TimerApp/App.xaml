<Application
    x:Class="TimerApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TimerApp"
    xmlns:helpers="using:TimerApp.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Дополнительно подключите сюда другие словари -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Один яркий акцентный цвет приложения (Windows 11 blue) -->
            <Color x:Key="TimerAccentColor">#4CC2FF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource TimerAccentColor}" />

            <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
