<Window
    x:Class="TimerApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TimerApp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Таймер"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.Resources>
            <!-- Мигание цифр после окончания отсчёта -->
            <Storyboard x:Key="FinishedStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="TimeDisplayText"
                    Storyboard.TargetProperty="Opacity"
                    From="1" To="0.25"
                    Duration="0:0:0.5"
                    AutoReverse="True"
                    RepeatBehavior="Forever" />
            </Storyboard>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="PresetButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="6,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <!-- Адаптивность: компактный вид при узком окне -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RingControl.Width" Value="208" />
                        <Setter Target="RingControl.Height" Value="208" />
                        <Setter Target="TimeDisplayText.FontSize" Value="40" />
                        <Setter Target="ContentPanel.Padding" Value="16,4,16,16" />
                        <Setter Target="HeaderSubtitle.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NormalState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="560" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RingControl.Width" Value="260" />
                        <Setter Target="RingControl.Height" Value="260" />
                        <Setter Target="TimeDisplayText.FontSize" Value="52" />
                        <Setter Target="ContentPanel.Padding" Value="24,8,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Заголовок окна / TitleBar ===================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Margin="16,0,150,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE916;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                <StackPanel>
                    <TextBlock Text="Таймер" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="HeaderSubtitle"
                        Text="Точный отсчёт по времени окончания"
                        FontSize="11"
                        Opacity="0.65" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="4">
                <Button
                    x:Name="CompactButton"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Click="CompactButton_Click"
                    ToolTipService.ToolTip="Компактный размер окна">
                    <FontIcon Glyph="&#xE740;" FontSize="14" />
                </Button>
                <Button
                    Style="{StaticResource TitleBarButtonStyle}"
                    Command="{Binding ToggleMuteCommand}"
                    ToolTipService.ToolTip="Отключить / включить звук">
                    <Grid>
                        <FontIcon
                            Glyph="&#xE767;" FontSize="15"
                            Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <FontIcon
                            Glyph="&#xE74F;" FontSize="15"
                            Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>
                <Button
                    Style="{StaticResource TitleBarButtonStyle}"
                    Click="ToggleThemeButton_Click"
                    ToolTipService.ToolTip="Светлая / тёмная тема">
                    <Grid>
                        <!-- В тёмной теме показываем солнце (перейти к светлой) -->
                        <FontIcon
                            Glyph="&#xE706;" FontSize="15"
                            Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}" />
                        <FontIcon
                            Glyph="&#xE708;" FontSize="15"
                            Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================== Контент ============================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ContentPanel"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                Padding="24,8,24,24"
                Spacing="16">

                <!-- Кольцо + крупные цифры -->
                <Grid Height="276">
                    <controls:CircularProgressControl
                        x:Name="RingControl"
                        Width="260"
                        Height="260"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Progress="{Binding Progress, Mode=OneWay}"
                        StrokeBrush="{StaticResource AccentBrush}" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            x:Name="TimeDisplayText"
                            Text="{Binding DisplayTime, Mode=OneWay}"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="52"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            CharacterSpacing="40" />
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="13" Opacity="0.75" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Панель «Время вышло» -->
                <InfoBar
                    Title="Время вышло"
                    Message="Отсчёт завершён. Нажмите «Сброс» или запустите таймер ещё раз."
                    Severity="Success"
                    IsClosable="False"
                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />

                <!-- Кнопки управления -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding StartCommand}"
                        Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}"
                        MinWidth="132"
                        CornerRadius="8"
                        Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Старт" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding PauseCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                        MinWidth="132"
                        CornerRadius="8"
                        Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE769;" FontSize="14" />
                            <TextBlock Text="Пауза" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding ResumeCommand}"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}"
                        MinWidth="132"
                        CornerRadius="8"
                        Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Продолжить" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding ResetCommand}"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                        MinWidth="110"
                        CornerRadius="8"
                        Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Сброс" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Ввод длительности -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Длительность" FontWeight="SemiBold" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <NumberBox
                                Header="Часы"
                                Minimum="0" Maximum="23"
                                SmallChange="1" LargeChange="1"
                                SpinButtonPlacementMode="Compact"
                                IsEnabled="{Binding CanEditInputs}"
                                Value="{Binding HoursInput, Mode=TwoWay}"
                                Width="104" />
                            <NumberBox
                                Header="Минуты"
                                Minimum="0" Maximum="59"
                                SmallChange="1" LargeChange="5"
                                SpinButtonPlacementMode="Compact"
                                IsEnabled="{Binding CanEditInputs}"
                                Value="{Binding MinutesInput, Mode=TwoWay}"
                                Width="104" />
                            <NumberBox
                                Header="Секунды"
                                Minimum="0" Maximum="59"
                                SmallChange="1" LargeChange="5"
                                SpinButtonPlacementMode="Compact"
                                IsEnabled="{Binding CanEditInputs}"
                                Value="{Binding SecondsInput, Mode=TwoWay}"
                                Width="104" />
                        </StackPanel>
                        <TextBlock
                            Text="Во время отсчёта и паузы поля ввода заблокированы."
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Пресеты -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Пресеты" FontWeight="SemiBold" FontSize="14" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="1 мин" Style="{StaticResource PresetButtonStyle}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="60" />
                            <Button Grid.Column="1" Content="5 мин" Style="{StaticResource PresetButtonStyle}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="300" />
                            <Button Grid.Column="2" Content="15 мин" Style="{StaticResource PresetButtonStyle}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="900" />
                            <Button Grid.Column="3" Content="25 мин" Style="{StaticResource PresetButtonStyle}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="1500" />
                            <Button Grid.Column="4" Content="45 мин" Style="{StaticResource PresetButtonStyle}"
                                    IsEnabled="{Binding CanEditInputs}"
                                    Command="{Binding ApplyPresetCommand}" CommandParameter="2700" />
                        </Grid>

                        <TextBlock
                            Text="Свои пресеты"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,4,0,0" />
                        <TextBlock
                            Text="Пока нет своих пресетов. Нажмите «Добавить пресет», чтобы сохранить удобную длительность."
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasCustomPresets, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                        <GridView
                            ItemsSource="{Binding CustomPresets}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="CustomPresetsGridView_ItemClick"
                            Visibility="{Binding HasCustomPresets, Converter={StaticResource BoolToVisibility}}">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Padding="6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Click="ApplyCustomPresetButton_Click"
                                                ToolTipService.ToolTip="Применить пресет">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding DurationText}" FontSize="11" Opacity="0.65" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                CornerRadius="6"
                                                Padding="7,6"
                                                VerticalAlignment="Stretch"
                                                ToolTipService.ToolTip="Удалить пресет"
                                                Click="DeleteCustomPresetButton_Click">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Button
                            Content="Добавить пресет"
                            CornerRadius="8"
                            IsEnabled="{Binding CanEditInputs}"
                            Click="AddCustomPresetButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Звук -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Звук" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock
                                Text="{Binding VolumeText, Mode=OneWay}"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                Opacity="0.7" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                CornerRadius="8"
                                Command="{Binding ToggleMuteCommand}"
                                ToolTipService.ToolTip="Отключить / включить звук">
                                <Grid>
                                    <FontIcon
                                        Glyph="&#xE767;" FontSize="15"
                                        Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <FontIcon
                                        Glyph="&#xE74F;" FontSize="15"
                                        Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Button>
                            <Slider
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                VerticalAlignment="Center"
                                Value="{Binding VolumePercent, Mode=TwoWay}" />
                            <Button
                                Grid.Column="2"
                                Content="Проверка"
                                CornerRadius="8"
                                IsEnabled="{Binding IsNotMuted}"
                                Command="{Binding PreviewSoundCommand}" />
                        </Grid>
                        <TextBlock
                            Text="По окончании: звуковой сигнал и уведомление Windows — даже если окно свёрнуто."
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="Горячие клавиши:  Пробел — старт / пауза / продолжить  •  Esc — сброс  •  Enter — старт"
                    FontSize="12"
                    Opacity="0.55"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
